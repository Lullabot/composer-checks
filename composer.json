{
  "name": "lullabot/composer-checks",
  "description": "Composer checks plugin",
  "license": "MIT",
  "type": "composer-plugin",

  "authors": [
    {
      "name": "rene-ipiales-lullabot",
      "email": "rene.ipiales@lullabot.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "composer-plugin-api": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Lullabot\\ComposerChecks\\": "src"
    }
  },
  "extra": {
    "class": "Lullabot\\ComposerChecks\\ComposerChecksPlugin",
    "composer-version": "^2.8.6"
  },
  "require-dev": {
    "composer/composer": "^2.8",
    "phpunit/phpunit": "^10.5.47",
    "symfony/process": "^6.4.20"
  },
  "autoload-dev": {
    "psr-4": {
      "Lullabot\\ComposerChecks\\Tests\\": "tests/src"
    }
  }
}
